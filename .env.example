# Template for .env — copy to .env and fill in. Safe to commit: contains no secrets.

# --- Market data -------------------------------------------------------------
# Massive (formerly Polygon.io) API key from https://massive.com/dashboard/keys
# Leave empty to use the built-in market simulator.
MASSIVE_API_KEY=

# Simulator tuning (only used when MASSIVE_API_KEY is empty)
MARKET_SIMULATOR_TICK_INTERVAL=500ms
MARKET_SIMULATOR_TIME_SCALE=1.0
# Fixed seed for reproducible prices; leave empty for random
MARKET_SIMULATOR_SEED=

# --- Backend (Spring Boot) ---------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
LOGGING_LEVEL_COM_FINALLYAPP=DEBUG

# --- Frontend ----------------------------------------------------------------
# Origin allowed by backend CORS during development
FRONTEND_ORIGIN=http://localhost:3000
